# Install to /etc/cron.d/pi-disk-cleanup (owner root, mode 0644, must end in newline).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUNNER_HOME=/home/pi

# Sunday 04:00 - reclaim Docker image/cache and runner log disk usage
0 4 * * 0 root /usr/local/sbin/pi-disk-cleanup.sh >/dev/null 2>&1
